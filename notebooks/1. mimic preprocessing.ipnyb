      "source": [
        "# ============================================================\n",
        "# Step 1: Load and inspect MIMIC-IV datasets\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# 1️⃣ Set root directory path\n",
        "data_path = r\"C:/Users/zshi6/MIMIC/dataset\"\n",
        "\n",
        "# 2️⃣ Read key files\n",
        "files = {\n",
        "    \"admissions\": pd.read_csv(f\"{data_path}/admissions.csv\", nrows=5),\n",
        "    \"patients\": pd.read_csv(f\"{data_path}/patients.csv\", nrows=5),\n",
        "    \"diagnoses_icd\": pd.read_csv(f\"{data_path}/diagnoses_icd.csv\", nrows=5),\n",
        "    \"discharge\": pd.read_csv(f\"{data_path}/discharge.csv\", nrows=5)\n",
        "}\n",
        "\n",
        "# 3️⃣ Print basic information for each file\n",
        "for name, df in files.items():\n",
        "    print(f\"\\n===== {name.upper()} =====\")\n",
        "    print(f\"Shape: {df.shape}\")\n",
        "    print(df.head())"
      ]
    },
