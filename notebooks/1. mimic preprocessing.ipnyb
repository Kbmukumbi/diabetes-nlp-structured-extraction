            "⏳ Reading discharge.csv in chunks...\n",
            "📄 Selected discharge notes: (65531, 8)\n",
            "💾 Saved merged notes -> C:/Users/zshi6/MIMIC/dataset\\diabetes_patient_notes_raw.csv\n"
          ]
        }
      ],
      "source": [
        "# ------------------------------------------------------------\n",
        "# Step 4.1: Load discharge notes (chunk version)\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "import pandas as pd\n",
        "import os\n",
        "import re\n",
        "\n",
        "data_path = r\"C:/Users/zshi6/MIMIC/dataset\"\n",
        "\n",
        "# Load the diabetes patient subject_id list in Step 3\n",
        "diabetes_info = pd.read_csv(os.path.join(data_path, \"diabetes_patients_info.csv\"))\n",
        "diabetes_ids = set(diabetes_info[\"subject_id\"].unique())\n",
        "\n",
        "# Used to store matched records\n",
        "filtered_rows = []\n",
        "\n",
        "# Block reading to avoid memory explosion\n",
        "chunk_size = 50000\n",
        "file_path = os.path.join(data_path, \"discharge.csv\")\n",
        "\n",
        "print(\"⏳ Reading discharge.csv in chunks...\")\n",
        "\n",
        "for chunk in pd.read_csv(file_path, chunksize=chunk_size, low_memory=False):\n",
        "    # Standardized column names\n",
        "    chunk.columns = [c.lower().strip() for c in chunk.columns]\n",
        "\n",
        "    # MIMIC-IV Notes: text\n",
        "    if \"text\" not in chunk.columns:\n",
        "        raise ValueError(\"ERROR: The column 'text' is NOT found in discharge.csv!\")\n",
        "\n",
        "    # Filtering diabetes subject_id\n",
        "    part = chunk[chunk[\"subject_id\"].isin(diabetes_ids)]\n",
        "\n",
        "    if len(part) > 0:\n",
        "        filtered_rows.append(part)\n",
        "\n",
        "# Merge all block results\n",
        "diabetes_notes = pd.concat(filtered_rows, ignore_index=True)\n",
        "print(\"📄 Selected discharge notes:\", diabetes_notes.shape)\n",
        "\n",
        "# Merge into a complete discharge summary for each patient\n",
        "patient_notes = diabetes_notes.groupby(\"subject_id\")[\"text\"].apply(lambda x: \" \".join(x)).reset_index()\n",
        "\n",
        "# save output file\n",
        "output_file = os.path.join(data_path, \"diabetes_patient_notes_raw.csv\")\n",
        "patient_notes.to_csv(output_file, index=False)\n",
        "\n",
        "print(f\"💾 Saved merged notes -> {output_file}\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "w_fvs-q-TpgU",
        "outputId": "fb179879-7a3b-4db0-aeba-2564634b5a0a"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Loaded notes: (18618, 2)\n",
            "🧼 Cleaned notes saved -> C:/Users/zshi6/MIMIC/dataset\\diabetes_patient_notes_clean.csv\n"
          ]
        }
      ],
      "source": [
        "# ------------------------------------------------------------\n",
        "# Step 4.2: Clean discharge note text\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "import pandas as pd\n",
        "import os\n",
        "import re\n",
        "\n",
        "data_path = r\"C:/Users/zshi6/MIMIC/dataset\"\n",
        "\n",
        "# Loading Step 4.1 Output\n",
        "input_file = os.path.join(data_path, \"diabetes_patient_notes_raw.csv\")\n",
        "notes = pd.read_csv(input_file)\n",
        "\n",
        "print(\"Loaded notes:\", notes.shape)\n",
        "\n",
        "# -------------------------\n",
        "# Define lightweight text cleaning function\n",
        "# -------------------------\n",
        "def clean_text(text):\n",
        "    if pd.isna(text):\n",
        "        return \"\"\n",
        "\n",
        "    text = text.lower()                       # ⬇  all lowercase\n",
        "    text = text.replace(\"\\n\", \" \")            # ⬇  Remove line breaks\n",
        "    text = re.sub(r\"[^a-z0-9\\s]\", \" \", text)  # ⬇  Keep alphanumeric characters\n",
        "    text = re.sub(r\"\\s+\", \" \", text)          # ⬇ Merge multiple spaces\n",
        "    return text.strip()\n",
        "\n",
        "# process text\n",
        "notes[\"clean_text\"] = notes[\"text\"].apply(clean_text)\n",
        "\n",
        "# save output file\n",
        "output_file = os.path.join(data_path, \"diabetes_patient_notes_clean.csv\")\n",
        "notes.to_csv(output_file, index=False)\n",
        "\n",
        "print(\"🧼 Cleaned notes saved ->\", output_file)\n"
      ]
    },
