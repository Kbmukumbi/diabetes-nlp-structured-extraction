          "name": "stdout",
          "output_type": "stream",
          "text": [
            "✅ Diabetes cohort loaded: 27727 patients\n",
            "⏳ Loading prescriptions.csv in chunks...\n",
            "💊 Filtered drug records: (622203, 21)\n",
            "💾 Saved filtered prescriptions to diabetes_drugs_filtered.csv\n"
          ]
        }
      ],
      "source": [
        "# ============================================================\n",
        "# Step 3: Read prescriptions. csv in chunks (avoid memory explosion)\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import os\n",
        "\n",
        "data_path = r\"C:/Users/zshi6/MIMIC/dataset\"\n",
        "\n",
        "# input outcomes from Step 2\n",
        "diabetes_info = pd.read_csv(os.path.join(data_path, \"diabetes_patients_info.csv\"))\n",
        "diabetes_info.columns = [c.lower() for c in diabetes_info.columns]\n",
        "\n",
        "diabetes_subjects = set(diabetes_info[\"subject_id\"].unique())\n",
        "\n",
        "print(f\"✅ Diabetes cohort loaded: {len(diabetes_subjects)} patients\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3️⃣ prescriptions.csv Block reading\n",
        "# ------------------------------------------------------------\n",
        "chunk_size = 300000   # Read 300000 rows each time\n",
        "drug_keywords = [\"insulin\", \"metformin\", \"glipizide\", \"glyburide\", \"pioglitazone\"]\n",
        "\n",
        "filtered_drug_rows = []   # Used for accumulating results\n",
        "\n",
        "presc_path = os.path.join(data_path, \"prescriptions.csv\")\n",
        "print(\"⏳ Loading prescriptions.csv in chunks...\")\n",
        "\n",
        "for chunk in pd.read_csv(presc_path, chunksize=chunk_size, low_memory=False):\n",
        "    chunk.columns = [c.lower() for c in chunk.columns]\n",
        "\n",
        "    # Keep records of diabetes patients only\n",
        "    chunk = chunk[chunk[\"subject_id\"].isin(diabetes_subjects)]\n",
        "\n",
        "    # Screening of diabetes related drugs\n",
        "    chunk = chunk[\n",
        "        chunk[\"drug\"].astype(str).str.lower().str.contains(\"|\".join(drug_keywords), na=False)\n",
        "    ]\n",
        "\n",
        "    filtered_drug_rows.append(chunk)\n",
        "\n",
        "# Merge all block results\n",
        "diabetes_drugs = pd.concat(filtered_drug_rows, ignore_index=True)\n",
        "print(f\"💊 Filtered drug records: {diabetes_drugs.shape}\")\n",
        "\n",
        "# Keep the main column\n",
        "keep_cols = [\"subject_id\", \"hadm_id\", \"drug\", \"startdate\", \"enddate\"]\n",
        "keep_cols = [c for c in keep_cols if c in diabetes_drugs.columns]\n",
        "\n",
        "diabetes_drugs = diabetes_drugs[keep_cols].drop_duplicates()\n",
        "\n",
        "# save\n",
        "diabetes_drugs.to_csv(os.path.join(data_path, \"diabetes_drugs_filtered.csv\"), index=False)\n",
        "print(\"💾 Saved filtered prescriptions to diabetes_drugs_filtered.csv\")\n"
      ]
    },
    {
