      "source": [
        "# ------------------------------------------------------------\n",
        "# Step 4.3:MiniLM Text Embedding (Embedding Extraction)\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "from sentence_transformers import SentenceTransformer\n",
        "\n",
        "data_path = r\"C:/Users/zshi6/MIMIC/dataset\"\n",
        "\n",
        "# Read the cleaned text\n",
        "notes_df = pd.read_csv(os.path.join(data_path, \"diabetes_patient_notes_clean.csv\"))\n",
        "print(\"📄 Loaded notes:\", notes_df.shape)\n",
        "\n",
        "# Load MiniLM model\n",
        "print(\"⏳ Loading MiniLM model...\")\n",
        "model = SentenceTransformer(\"sentence-transformers/all-MiniLM-L6-v2\")\n",
        "\n",
        "print(\"🚀 Encoding text...\")\n",
        "embeddings = model.encode(\n",
        "    notes_df[\"clean_text\"].tolist(),\n",
        "    batch_size=16,\n",
        "    show_progress_bar=True\n",
        ")\n",
        "\n",
        "# Convert to DataFrame (each embedding is 384 dimensions)\n",
        "emb_df = pd.DataFrame(embeddings)\n",
        "emb_df.insert(0, \"subject_id\", notes_df[\"subject_id\"])\n",
        "\n",
        "print(\"🧬 Embeddings shape:\", emb_df.shape)\n",
        "\n",
        "# save output file\n",
        "save_path = os.path.join(data_path, \"diabetes_patient_embeddings.csv\")\n",
        "emb_df.to_csv(save_path, index=False)\n",
        "\n",
        "print(f\"💾 Saved MiniLM embeddings to: {save_path}\")"
      ]
    },
    {
