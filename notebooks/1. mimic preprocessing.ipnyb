      "source": [
        "# ============================================================\n",
        "# Step 2: Filter diabetes patients (ICD E10–E14)\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import os\n",
        "\n",
        "# 1️⃣ Set data path\n",
        "data_path = r\"C:/Users/zshi6/MIMIC/dataset\"\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Define secure read functions: automatically convert to lowercase, remove spaces\n",
        "# ------------------------------------------------------------\n",
        "def read_csv_safely(filepath):\n",
        "    df = pd.read_csv(filepath, low_memory=False)\n",
        "    df.columns = [c.strip().lower() for c in df.columns]\n",
        "    return df\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2️⃣ Read key tables\n",
        "# ------------------------------------------------------------\n",
        "diagnoses = read_csv_safely(os.path.join(data_path, \"diagnoses_icd.csv\"))\n",
        "admissions = read_csv_safely(os.path.join(data_path, \"admissions.csv\"))\n",
        "patients = read_csv_safely(os.path.join(data_path, \"patients.csv\"))\n",
        "\n",
        "print(\"✅ Files loaded successfully!\\n\")\n",
        "print(\"[diagnoses_icd columns]:\", diagnoses.columns.tolist())\n",
        "print(\"[admissions columns]:\", admissions.columns.tolist())\n",
        "print(\"[patients columns]:\", patients.columns.tolist())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3️⃣ Ensure the existence of key columns\n",
        "# ------------------------------------------------------------\n",
        "for df_name, df, needed in [\n",
        "    (\"diagnoses_icd\", diagnoses, [\"subject_id\", \"hadm_id\", \"icd_code\"]),\n",
        "    (\"admissions\", admissions, [\"hadm_id\"]),\n",
        "    (\"patients\", patients, [\"subject_id\"])\n",
        "]:\n",
        "    for col in needed:\n",
        "        if col not in df.columns:\n",
        "            raise KeyError(f\"❌ Missing column '{col}' in {df_name}. Found: {df.columns.tolist()}\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4️⃣ Screening for diabetes ICD codes (E10 – E14)\n",
        "# ------------------------------------------------------------\n",
        "diabetes_dx = diagnoses[\n",
        "    diagnoses[\"icd_code\"].astype(str).str.startswith((\"E10\", \"E11\", \"E12\", \"E13\", \"E14\"), na=False)\n",
        "].copy()\n",
        "\n",
        "print(f\"\\n✅ Filtered diabetes diagnosis records: {diabetes_dx.shape[0]}\")\n",
        "print(diabetes_dx.head())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5️⃣ Keep only key columns\n",
        "# ------------------------------------------------------------\n",
        "diabetes_dx = diabetes_dx[[\"subject_id\", \"hadm_id\", \"icd_code\"]].drop_duplicates()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6️⃣ Merge admissions table (by hadm_id)\n",
        "# ------------------------------------------------------------\n",
        "adm_keep = [\n",
        "    \"hadm_id\", \"subject_id\", \"admittime\", \"dischtime\", \"deathtime\",\n",
        "    \"admission_type\", \"admission_location\", \"discharge_location\",\n",
        "    \"insurance\", \"language\", \"marital_status\"\n",
        "]\n",
        "adm_keep = [c for c in adm_keep if c in admissions.columns]  # 自动兼容字段\n",
        "admissions_slim = admissions[adm_keep].copy()\n",
        "\n",
        "# Merge and resolve subject_id conflicts\n",
        "diabetes_adm = pd.merge(diabetes_dx, admissions_slim, on=\"hadm_id\", how=\"left\", suffixes=(\"_dx\", \"_adm\"))\n",
        "\n",
        "if \"subject_id_dx\" in diabetes_adm.columns or \"subject_id_adm\" in diabetes_adm.columns:\n",
        "    diabetes_adm[\"subject_id\"] = (\n",
        "        diabetes_adm.get(\"subject_id_dx\").fillna(diabetes_adm.get(\"subject_id_adm\"))\n",
        "    )\n",
        "    diabetes_adm.drop(columns=[c for c in [\"subject_id_dx\", \"subject_id_adm\"] if c in diabetes_adm.columns],\n",
        "                      inplace=True)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7️⃣ Merge the patients table again (by subject_id)\n",
        "# ------------------------------------------------------------\n",
        "diabetes_patients = pd.merge(diabetes_adm, patients, on=\"subject_id\", how=\"left\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8️⃣ Keep main fields\n",
        "# ------------------------------------------------------------\n",
        "selected_cols = [\n",
        "    \"subject_id\", \"hadm_id\", \"icd_code\",\n",
        "    \"admittime\", \"dischtime\", \"deathtime\",\n",
        "    \"admission_type\", \"admission_location\", \"discharge_location\",\n",
        "    \"insurance\", \"language\", \"marital_status\",\n",
        "    \"gender\", \"anchor_age\", \"anchor_year\"\n",
        "]\n",
        "\n",
        "selected_cols = [c for c in selected_cols if c in diabetes_patients.columns]\n",
        "diabetes_info = diabetes_patients[selected_cols].drop_duplicates()\n",
        "\n",
        "print(f\"\\n✅ Diabetes patient dataset created: {diabetes_info.shape}\")\n",
        "print(diabetes_info.head())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9️⃣ Save results for use in Step 3\n",
        "# ------------------------------------------------------------\n",
        "output_path = os.path.join(data_path, \"diabetes_patients_info.csv\")\n",
        "diabetes_info.to_csv(output_path, index=False, encoding=\"utf-8-sig\")\n",
        "print(f\"💾 Saved diabetes patient info to: {output_path}\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "tKQwJasfTpgT",
