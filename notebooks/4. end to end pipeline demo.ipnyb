      "cell_type": "code",
      "source": [
        "# ---------- STEP 4: CLEANING ----------\n",
        "def clean_note(text: str) -> str:\n",
        "    if pd.isna(text):\n",
        "        return \"\"\n",
        "\n",
        "    # 1) Remove PHI placeholders like \"___\" or [** **]\n",
        "    text = re.sub(r'_{2,}', ' ', text)                 # ___ → space\n",
        "    text = re.sub(r'\\[\\*\\*.*?\\*\\*\\]', ' ', text)       # [**Name**] → space\n",
        "\n",
        "    # 2) Normalize weird dashes / quotes to plain ASCII\n",
        "    text = text.replace('\\u2013', '-').replace('\\u2014', '-')  # en/em dashes\n",
        "    text = text.replace('\\u2018', \"'\").replace('\\u2019', \"'\")\n",
        "    text = text.replace('\\u201c', '\"').replace('\\u201d', '\"')\n",
        "\n",
        "    # 3) Lowercase everything (model will handle casing if needed)\n",
        "    text = text.lower()\n",
        "\n",
        "    # 4) Remove non-ASCII control characters\n",
        "    text = re.sub(r'[^\\x09\\x0A\\x0D\\x20-\\x7E]', ' ', text)\n",
        "\n",
        "    # 5) Normalize whitespace (spaces + newlines)\n",
        "    text = re.sub(r'[ \\t]+', ' ', text)         # collapse multiple spaces\n",
        "    text = re.sub(r'\\n\\s*\\n\\s*\\n+', '\\n\\n', text)  # max 2 blank lines\n",
        "    text = re.sub(r' +\\n', '\\n', text)         # no trailing spaces at end of line\n",
        "\n",
        "    return text.strip()\n",
        "\n",
        "# Apply cleaning\n",
        "diabetes_notes_20k['clean_text'] = diabetes_notes_20k['text'].astype(str).apply(clean_note)\n",
        "\n",
        "# Quick sanity check\n",
        "print(\"Example after CLEANING:\\n\")\n",
        "print(diabetes_notes_20k['clean_text'].iloc[0][:1000])\n"
      ],
      "metadata": {
