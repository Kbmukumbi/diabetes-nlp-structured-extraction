    {
      "cell_type": "code",
      "source": [
        "#Step 2 Load diagnoses and find diabetes admissions\n",
        "import pandas as pd\n",
        "\n",
        "diag_path = '/content/drive/MyDrive/diagnoses_icd.csv'\n",
        "\n",
        "# Read diagnoses; keep only needed columns to save RAM\n",
        "diags = pd.read_csv(diag_path, usecols=['subject_id', 'hadm_id', 'icd_code'])\n",
        "\n",
        "# Clean codes a bit\n",
        "diags['icd_code'] = (\n",
        "    diags['icd_code']\n",
        "    .astype(str)\n",
        "    .str.replace('.', '', regex=False)  # remove dots if present\n",
        "    .str.upper()\n",
        "    .str.strip()\n",
        ")\n",
        "\n",
        "# Diabetes ICD prefixes (ICD9 + ICD10)\n",
        "diab_prefixes = ('250', 'E08', 'E09', 'E10', 'E11', 'E12', 'E13', 'E14', 'O24')\n",
        "\n",
        "# Flag diabetes rows\n",
        "is_diabetes = diags['icd_code'].str.startswith(diab_prefixes)\n",
        "\n",
        "# All admissions that have at least one diabetes code\n",
        "diab_hadm_ids = diags.loc[is_diabetes, 'hadm_id'].dropna().unique()\n",
        "len(diab_hadm_ids), diab_hadm_ids[:10]\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "xAxmJ0qcr0ZQ",
        "outputId": "b743e852-5cfd-49df-b139-4989ab34bd92"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "(134286,\n",
              " array([20642640, 26134563, 20897796, 24947999, 25242409, 25911675,\n",
              "        26913865, 29654838, 29659838, 23334588]))"
            ]
          },
          "metadata": {},
          "execution_count": 19
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 3 Filter discharge.csv in chunks to keep only diabetes notes\n",
        "import numpy as np\n",
        "\n",
        "disch_path = '/content/drive/MyDrive/discharge.csv'\n",
        "\n",
        "diab_hadm_set = set(diab_hadm_ids)  # for fast lookup\n",
        "\n",
        "chunksize = 100000\n",
        "filtered_chunks = []\n",
        "\n",
        "# Only keep useful columns for NLP\n",
        "usecols = ['subject_id', 'hadm_id', 'charttime', 'text']\n",
        "\n",
        "for chunk in pd.read_csv(disch_path, chunksize=chunksize, usecols=usecols):\n",
        "    keep = chunk['hadm_id'].isin(diab_hadm_set)\n",
        "    filtered = chunk[keep]\n",
        "    if not filtered.empty:\n",
        "        filtered_chunks.append(filtered)\n",
        "\n",
        "discharge_diab = pd.concat(filtered_chunks, ignore_index=True)\n",
        "\n",
        "discharge_diab.shape\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "jWqzEv_Hr0bZ",
        "outputId": "49e77b26-01b6-4e29-f059-f26d10be218b"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "(90474, 4)"
            ]
          },
          "metadata": {},
          "execution_count": 20
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 4 Take a random sample of 20,000 notes\n",
        "target_n = 20000\n",
        "\n",
        "if len(discharge_diab) > target_n:\n",
        "    diabetes_notes_20k = discharge_diab.sample(n=target_n, random_state=42)\n",
        "else:\n",
        "    diabetes_notes_20k = discharge_diab.copy()\n",
        "\n",
        "diabetes_notes_20k.shape\n"
      ],
