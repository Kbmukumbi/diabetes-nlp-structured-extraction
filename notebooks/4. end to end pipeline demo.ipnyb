            " {'LAB_RESULT': [{'sentence': 'ros: pt denies cp, sob, cough, nausea, vomitting, fevers\\n\\npast medical history:\\n- lle cellulitis (recently admitted, treated with unasyn, then\\nswitched to course of augmentin)\\n-iddm, last hga1c 10.1.', 'lab': 'a1c', 'value': '10.1.', 'unit': ''}], 'MED_ORDER': []}\n"
          ]
