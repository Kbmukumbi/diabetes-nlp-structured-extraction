        "#Step 3️ Filter discharge.csv in chunks to keep only diabetes notes\n",
        "import numpy as np\n",
        "\n",
        "disch_path = '/content/drive/MyDrive/discharge.csv'\n",
        "\n",
        "diab_hadm_set = set(diab_hadm_ids)  # for fast lookup\n",
        "\n",
        "chunksize = 100000\n",
        "filtered_chunks = []\n",
        "\n",
        "# Only keep useful columns for NLP\n",
        "usecols = ['subject_id', 'hadm_id', 'charttime', 'text']\n",
        "\n",
        "for chunk in pd.read_csv(disch_path, chunksize=chunksize, usecols=usecols):\n",
        "    keep = chunk['hadm_id'].isin(diab_hadm_set)\n",
        "    filtered = chunk[keep]\n",
        "    if not filtered.empty:\n",
        "        filtered_chunks.append(filtered)\n",
        "\n",
        "discharge_diab = pd.concat(filtered_chunks, ignore_index=True)\n",
        "\n",
        "discharge_diab.shape\n"
      ],
