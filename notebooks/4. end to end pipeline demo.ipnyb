    {
      "cell_type": "code",
      "source": [
        "#Step 8 using a relation extraction dataset to train & evaluate a ClinicalBERT classifier"
      ],
      "metadata": {
        "id": "vIjV54uzUNcO"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [],
      "metadata": {
        "id": "N0k3TYyZVh3F"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================\n",
        "# 0. Mount Google Drive\n",
        "# ============================================\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# ============================================\n",
        "# 1. Load the Kaggle JSONL file\n",
        "# ============================================\n",
        "import json\n",
        "import pandas as pd\n",
        "import re\n",
        "\n",
        "# TODO: change path if needed\n",
        "JSONL_PATH = \"/content/drive/MyDrive/prompt1.jsonl\"\n",
        "\n",
        "rows = []\n",
        "with open(JSONL_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    for line in f:\n",
        "        rows.append(json.loads(line))\n",
        "\n",
        "df_kaggle = pd.DataFrame(rows)\n",
        "print(\"Original shape:\", df_kaggle.shape)\n",
        "print(df_kaggle.head(3))\n",
        "\n",
        "# ============================================\n",
        "# 2. Extract relation label + clean text\n",
        "# ============================================\n",
        "\n",
        "def get_relation(resp_str):\n",
        "    \"\"\"Robustly parse 'response' to extract the Relation label.\"\"\"\n",
        "    if isinstance(resp_str, dict):\n",
        "        return resp_str.get(\"Relation\", \"NO_RELATION\")\n",
        "\n",
        "    s = str(resp_str).strip()\n",
        "\n",
        "    # Try normal JSON\n",
        "    try:\n",
        "        d = json.loads(s)\n",
        "        if isinstance(d, dict):\n",
        "            return d.get(\"Relation\", \"NO_RELATION\")\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "    # Try after swapping single quotes to double quotes\n",
        "    try:\n",
        "        s2 = s.replace(\"'\", '\"')\n",
        "        d = json.loads(s2)\n",
        "        if isinstance(d, dict):\n",
        "            return d.get(\"Relation\", \"NO_RELATION\")\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "    # Regex fallback\n",
        "    m = re.search(r'Relation[\"\\']?\\s*[:=]\\s*[\"\\']([^\"\\']+)[\"\\']', s)\n",
        "    if m:\n",
        "        return m.group(1)\n",
        "\n",
        "    return \"NO_RELATION\"\n",
        "\n",
        "\n",
        "df_kaggle[\"relation\"] = df_kaggle[\"response\"].apply(get_relation)\n",
        "\n",
        "def clean_context(x: str) -> str:\n",
        "    s = str(x)\n",
        "    s = s.replace(\"<<SUBJECT>>\", \"[SUBJ]\").replace(\"<</SUBJECT>>\", \"[/SUBJ]\")\n",
        "    s = s.replace(\"<<OBJECT>>\", \"[OBJ]\").replace(\"<</OBJECT>>\", \"[/OBJ]\")\n",
        "    return s\n",
        "\n",
        "df_kaggle[\"text\"] = df_kaggle[\"context\"].astype(str).apply(clean_context)\n",
        "\n",
        "df_kaggle = df_kaggle.dropna(subset=[\"text\", \"relation\"]).reset_index(drop=True)\n",
        "\n",
        "print(df_kaggle[[\"text\", \"relation\"]].head(5))\n",
        "print(\"Unique relations:\", df_kaggle[\"relation\"].unique())\n",
        "\n",
        "# ============================================\n",
        "# 3. Train / val / test splits + label IDs\n",
        "# ============================================\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "unique_labels = sorted(df_kaggle[\"relation\"].unique())\n",
        "label2id = {lab: i for i, lab in enumerate(unique_labels)}\n",
        "id2label = {i: lab for lab, i in label2id.items()}\n",
        "print(\"Label mapping:\", label2id)\n",
        "\n",
        "df_kaggle[\"label_id\"] = df_kaggle[\"relation\"].map(label2id)\n",
        "\n",
        "train_df, temp_df = train_test_split(\n",
        "    df_kaggle,\n",
        "    test_size=0.3,\n",
        "    random_state=42,\n",
        "    stratify=df_kaggle[\"label_id\"]\n",
        ")\n",
        "val_df, test_df = train_test_split(\n",
        "    temp_df,\n",
        "    test_size=0.5,\n",
        "    random_state=42,\n",
        "    stratify=temp_df[\"label_id\"]\n",
        ")\n",
        "\n",
        "print(\"Train:\", train_df.shape, \"Val:\", val_df.shape, \"Test:\", test_df.shape)\n",
        "\n",
        "# ============================================\n",
        "# 4. Tokenize with ClinicalBERT\n",
        "# ============================================\n",
        "!pip -q install transformers datasets accelerate evaluate\n",
        "\n",
        "from datasets import Dataset\n",
        "from transformers import AutoTokenizer\n",
        "\n",
        "model_name = \"emilyalsentzer/Bio_ClinicalBERT\"\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "\n",
        "train_ds = Dataset.from_pandas(train_df[[\"text\", \"label_id\"]])\n",
        "val_ds   = Dataset.from_pandas(val_df[[\"text\", \"label_id\"]])\n",
        "test_ds  = Dataset.from_pandas(test_df[[\"text\", \"label_id\"]])\n",
        "\n",
        "def tokenize_batch(batch):\n",
        "    return tokenizer(\n",
        "        batch[\"text\"],\n",
        "        padding=\"max_length\",\n",
        "        truncation=True,\n",
        "        max_length=128,\n",
        "    )\n",
        "\n",
        "train_ds = train_ds.map(tokenize_batch, batched=True)\n",
        "val_ds   = val_ds.map(tokenize_batch, batched=True)\n",
        "test_ds  = test_ds.map(tokenize_batch, batched=True)\n",
        "\n",
        "# Rename label_id -> labels\n",
        "train_ds = train_ds.rename_column(\"label_id\", \"labels\")\n",
        "val_ds   = val_ds.rename_column(\"label_id\", \"labels\")\n",
        "test_ds  = test_ds.rename_column(\"label_id\", \"labels\")\n",
        "\n",
        "train_ds.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\", \"labels\"])\n",
        "val_ds.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\", \"labels\"])\n",
        "test_ds.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\", \"labels\"])\n",
        "\n",
        "# ============================================\n",
        "# 5. Use a smaller subset for faster training\n",
        "# ============================================\n",
        "small_train_ds = train_ds.shuffle(seed=42).select(range(5000))\n",
        "small_val_ds   = val_ds.shuffle(seed=42).select(range(1000))\n",
        "\n",
        "print(\"Small train size:\", len(small_train_ds))\n",
        "print(\"Small val size:\", len(small_val_ds))\n",
        "\n",
        "# ============================================\n",
        "# 6. Model, Trainer, metrics\n",
        "# ============================================\n",
        "from transformers import (\n",
        "    AutoModelForSequenceClassification,\n",
        "    TrainingArguments,\n",
        "    Trainer,\n",
        "    DataCollatorWithPadding,\n",
        ")\n",
        "import numpy as np\n",
        "from sklearn.metrics import accuracy_score, precision_recall_fscore_support\n",
        "\n",
        "model = AutoModelForSequenceClassification.from_pretrained(\n",
        "    model_name,\n",
        "    num_labels=len(label2id),\n",
        "    id2label=id2label,\n",
        "    label2id=label2id,\n",
        ")\n",
        "\n",
        "data_collator = DataCollatorWithPadding(tokenizer)\n",
        "\n",
        "def compute_metrics(eval_pred):\n",
        "    logits, labels = eval_pred\n",
        "    preds = np.argmax(logits, axis=-1)\n",
        "    acc = accuracy_score(labels, preds)\n",
        "    prec, rec, f1, _ = precision_recall_fscore_support(\n",
        "        labels, preds, average=\"weighted\", zero_division=0\n",
        "    )\n",
        "    return {\n",
        "        \"accuracy\": acc,\n",
        "        \"precision\": prec,\n",
        "        \"recall\": rec,\n",
        "        \"f1\": f1,\n",
        "    }\n",
        "\n",
        "training_args = TrainingArguments(\n",
        "    output_dir=\"/content/clinicalbert_relation_i2b2_small\",\n",
        "    do_train=True,\n",
        "    do_eval=True,\n",
        "    logging_steps=50,\n",
        "    per_device_train_batch_size=16,\n",
        "    per_device_eval_batch_size=16,\n",
        "    num_train_epochs=1,\n",
        "    learning_rate=3e-5,\n",
        "    weight_decay=0.01,\n",
        "    save_steps=5000,           # instead of save_strategy\n",
        "    save_total_limit=1,        # keep disk clean\n",
        "    logging_dir=\"/content/logs\",\n",
        ")\n",
        "\n",
        "\n",
        "trainer = Trainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=small_train_ds,\n",
        "    eval_dataset=small_val_ds,\n",
        "    tokenizer=tokenizer,\n",
        "    data_collator=data_collator,\n",
        "    compute_metrics=compute_metrics,\n",
        ")\n",
        "\n",
        "# ============================================\n",
        "# 7. Train and evaluate\n",
        "# ============================================\n",
        "trainer.train()\n",
        "\n",
        "print(\"Validation metrics:\", trainer.evaluate(small_val_ds))\n",
        "print(\"Test metrics:\", trainer.evaluate(test_ds))\n"
      ],
