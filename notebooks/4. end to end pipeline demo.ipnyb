        "# STEP 3 — Diabetes-focused rule-based NER\n",
        "\n",
        "DIAB_ENT_PATTERNS = {\n",
        "    \"LAB_HBA1C\":        r\"\\b(hba1c|a1c|glycated hemoglobin)\\b\",\n",
        "    \"LAB_GLUCOSE\":      r\"\\b(glucose|blood sugar|glu|glc)\\b\",\n",
        "    \"MED_INSULIN\":      r\"\\b(insulin|lantus|novolog|humalog|levemir)\\b\",\n",
        "    \"MED_METFORMIN\":    r\"\\b(metformin|glucophage)\\b\",\n",
        "    \"MED_SULFONYLUREA\": r\"\\b(glyburide|glipizide|glimepiride)\\b\",\n",
        "    \"COMP_NEUROPATHY\":  r\"\\b(neuropathy|peripheral neuropathy)\\b\",\n",
        "    \"COMP_RETINOPATHY\": r\"\\b(retinopathy|diabetic retinopathy)\\b\",\n",
        "    \"COMP_NEPHROPATHY\": r\"\\b(nephropathy|kidney disease|ckd)\\b\",\n",
        "    \"COMP_DKA\":         r\"\\b(ketoacidosis|dka|diabetic ketoacidosis)\\b\"\n",
        "}\n",
        "\n",
        "def run_rule_ner(text: str):\n",
        "    \"\"\"\n",
        "    Return list of entities:\n",
        "    [{\"span\": \"...\", \"label\": \"MED_INSULIN\", \"start\": i, \"end\": j}, ...]\n",
        "    \"\"\"\n",
        "    ents = []\n",
        "    if not isinstance(text, str):\n",
        "        return ents\n",
        "\n",
        "    lower = text.lower()\n",
        "    for label, pat in DIAB_ENT_PATTERNS.items():\n",
        "        for m in re.finditer(pat, lower):\n",
        "            span = text[m.start():m.end()]\n",
        "            ents.append({\n",
        "                \"span\": span,\n",
        "                \"label\": label,\n",
        "                \"start\": int(m.start()),\n",
        "                \"end\": int(m.end())\n",
        "            })\n",
        "    return ents\n",
        "\n",
        "notes_df[\"entities\"] = notes_df[\"clean_text\"].apply(run_rule_ner)\n",
        "\n",
        "print(\"Example entities for first note:\\n\")\n",
        "notes_df[[\"clean_text\", \"entities\"]].head(1)\n"
      ],
