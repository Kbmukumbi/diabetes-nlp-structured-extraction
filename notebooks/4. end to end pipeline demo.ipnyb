        "import numpy as np\n",
        "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Get predictions from the trainer\n",
        "pred_output = trainer.predict(test_ds)\n",
        "\n",
        "# 2. Extract logits → predicted label IDs → true labels\n",
        "logits = pred_output.predictions\n",
        "y_pred = np.argmax(logits, axis=-1)\n",
        "y_true = pred_output.label_ids\n",
        "\n",
        "# 3. Build label list in the correct order\n",
        "id2label = {v: k for k, v in label2id.items()}\n",
        "label_names = [id2label[i] for i in range(len(id2label))]\n",
        "\n",
        "# 4. Create confusion matrix\n",
        "cm = confusion_matrix(y_true, y_pred)\n",
        "\n",
        "# 5. Plot\n",
        "plt.figure(figsize=(10, 8))\n",
        "disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=label_names)\n",
        "disp.plot(cmap=\"Blues\", xticks_rotation=45, ax=plt.gca(), colorbar=False)\n",
        "plt.title(\"Confusion Matrix – ClinicalBERT Medication Relation Extraction\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
