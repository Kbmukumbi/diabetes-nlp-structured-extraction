        "import spacy\n",
        "\n",
        "# Disable heavy components you don't need right now\n",
        "nlp = spacy.load(\"en_core_web_sm\", disable=[\"ner\", \"tagger\", \"lemmatizer\"])\n",
        "nlp.max_length = 2_000_000   # in case a note is very long\n"
      ],
