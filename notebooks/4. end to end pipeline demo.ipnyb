      "cell_type": "code",
      "source": [
        "#6.2 Sentence segmentation\n",
        "# ---------- Sentence segmentation ----------\n",
        "def segment_sentences(text: str):\n",
        "    if not text:\n",
        "        return []\n",
        "    doc = nlp(text)\n",
        "    return [sent.text.strip() for sent in doc.sents if sent.text.strip()]\n",
        "\n",
        "# To make it faster we start with a subse of  first 2 000 notes\n",
        "subset_for_seg = diabetes_notes_20k.head(2000).copy()\n",
        "\n",
        "subset_for_seg['sentences'] = subset_for_seg['clean_text'].apply(segment_sentences)\n",
        "\n",
        "print(\"\\nExample SENTENCES:\\n\")\n",
        "for i, s in enumerate(subset_for_seg['sentences'].iloc[0][:5]):\n",
        "    print(f\"Sentence {i+1}: {s}\")\n"
      ],
