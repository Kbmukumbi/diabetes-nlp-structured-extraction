        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "import pandas as pd\n",
        "import re\n",
        "\n",
        "# Path to your segmented subset\n",
        "SEG_PATH = \"/content/drive/MyDrive/diabetes_discharge_2k_segmented.pkl\"\n",
        "\n",
        "# Load and clean basic structure\n",
        "notes_df = pd.read_pickle(SEG_PATH).reset_index(drop=True)\n",
        "\n",
        "# Keep rows with non-empty clean_text\n",
        "notes_df = notes_df.dropna(subset=[\"clean_text\"]).reset_index(drop=True)\n",
        "\n",
        "print(\"Segmented diabetes notes shape:\", notes_df.shape)\n",
        "print(notes_df.columns)\n",
        "notes_df.head(2)\n"
      ],
