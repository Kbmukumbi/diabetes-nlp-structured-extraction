    },
    {
      "cell_type": "code",
      "source": [
        "# STEP 5 — Concept Normalization (map labs & meds to standard-like codes)\n",
        "\n",
        "CODE_MAP = {\n",
        "    \"hba1c\":            {\"loinc\": \"4548-4\"},      # Hemoglobin A1c\n",
        "    \"a1c\":              {\"loinc\": \"4548-4\"},\n",
        "    \"glucose\":          {\"loinc\": \"2345-7\"},      # Glucose [Mass/volume] in blood\n",
        "    \"blood sugar\":      {\"loinc\": \"2345-7\"},\n",
        "    \"insulin\":          {\"rxnorm\": \"705129\"},     # Insulin, human\n",
        "    \"metformin\":        {\"rxnorm\": \"860975\"},     # Metformin\n",
        "    \"glucophage\":       {\"rxnorm\": \"860975\"},\n",
        "    \"type 2 diabetes\":  {\"snomed\": \"44054006\"}    # Type 2 diabetes mellitus\n",
        "}\n",
        "\n",
        "def map_lab_to_code(lab_name: str):\n",
        "    \"\"\"Map lab name to example LOINC code dict.\"\"\"\n",
        "    if not isinstance(lab_name, str):\n",
        "        return {}\n",
        "    key = lab_name.lower().strip()\n",
        "    # handle common variants\n",
        "    if \"hba1c\" in key or \"a1c\" in key:\n",
        "        return CODE_MAP[\"hba1c\"]\n",
        "    if \"glucose\" in key:\n",
        "        return CODE_MAP[\"glucose\"]\n",
        "    if \"blood sugar\" in key:\n",
        "        return CODE_MAP[\"blood sugar\"]\n",
        "    return {}\n",
        "\n",
        "def map_med_to_code(med_name: str):\n",
        "    \"\"\"Map medication name to example RxNorm code dict.\"\"\"\n",
        "    if not isinstance(med_name, str):\n",
        "        return {}\n",
        "    key = med_name.lower().strip()\n",
        "    if \"insulin\" in key:\n",
        "        return CODE_MAP[\"insulin\"]\n",
        "    if \"metformin\" in key:\n",
        "        return CODE_MAP[\"metformin\"]\n",
        "    if \"glucophage\" in key:\n",
        "        return CODE_MAP[\"glucophage\"]\n",
        "    return {}\n",
        "\n",
        "# ---- Normalize entities (labs & meds) ----\n",
        "def normalize_entities(ents):\n",
        "    \"\"\"Attach codes to lab/med entities when possible.\"\"\"\n",
        "    norm_ents = []\n",
        "    if not isinstance(ents, list):\n",
        "        return norm_ents\n",
        "\n",
        "    for e in ents:\n",
        "        e = e.copy()\n",
        "        label = e.get(\"label\", \"\")\n",
        "        span = e.get(\"span\", \"\")\n",
        "        codes = {}\n",
        "\n",
        "        if label.startswith(\"LAB_\"):\n",
        "            codes = map_lab_to_code(span)\n",
        "        elif label.startswith(\"MED_\"):\n",
        "            codes = map_med_to_code(span)\n",
        "\n",
        "        e[\"codes\"] = codes\n",
        "        norm_ents.append(e)\n",
        "    return norm_ents\n",
        "\n",
        "notes_df[\"entities_normalized\"] = notes_df[\"entities\"].apply(normalize_entities)\n",
        "\n",
        "# ---- Normalize relations (LAB_RESULT + MED_ORDER) ----\n",
        "def normalize_relations(rel_dict):\n",
        "    \"\"\"Attach codes to lab/med in relation structures.\"\"\"\n",
        "    if not isinstance(rel_dict, dict):\n",
        "        return {\"LAB_RESULT\": [], \"MED_ORDER\": []}\n",
        "\n",
        "    out = {\"LAB_RESULT\": [], \"MED_ORDER\": []}\n",
        "\n",
        "    # Labs\n",
        "    for rel in rel_dict.get(\"LAB_RESULT\", []):\n",
        "        r = rel.copy()\n",
        "        r[\"codes\"] = map_lab_to_code(r.get(\"lab\", \"\"))\n",
        "        out[\"LAB_RESULT\"].append(r)\n",
        "\n",
        "    # Meds\n",
        "    for rel in rel_dict.get(\"MED_ORDER\", []):\n",
        "        r = rel.copy()\n",
        "        r[\"codes\"] = map_med_to_code(r.get(\"med\", \"\"))\n",
        "        out[\"MED_ORDER\"].append(r)\n",
        "\n",
        "    return out\n",
        "\n",
        "notes_df[\"relations_normalized\"] = notes_df[\"relations\"].apply(normalize_relations)\n",
        "\n",
        "# Quick example check (use the note at index 3 that had HbA1c 10.1)\n",
        "idx = 3\n",
        "print(\"=== Normalized entities (index\", idx, \") ===\")\n",
        "print(notes_df[\"entities_normalized\"].iloc[idx])\n",
        "\n",
        "print(\"\\n=== Normalized relations (index\", idx, \") ===\")\n",
        "print(notes_df[\"relations_normalized\"].iloc[idx])\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "fK_lsqaDNpBg",
        "outputId": "4f1ea0a2-9841-46e4-e4d3-4355dacdca87"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "=== Normalized entities (index 3 ) ===\n",
            "[{'span': 'glucose', 'label': 'LAB_GLUCOSE', 'start': 2633, 'end': 2640, 'codes': {'loinc': '2345-7'}}, {'span': 'glucose', 'label': 'LAB_GLUCOSE', 'start': 2719, 'end': 2726, 'codes': {'loinc': '2345-7'}}, {'span': 'insulin', 'label': 'MED_INSULIN', 'start': 997, 'end': 1004, 'codes': {'rxnorm': '705129'}}, {'span': 'insulin', 'label': 'MED_INSULIN', 'start': 4024, 'end': 4031, 'codes': {'rxnorm': '705129'}}, {'span': 'ckd', 'label': 'COMP_NEPHROPATHY', 'start': 1365, 'end': 1368, 'codes': {}}, {'span': 'nephropathy', 'label': 'COMP_NEPHROPATHY', 'start': 1396, 'end': 1407, 'codes': {}}]\n",
            "\n",
            "=== Normalized relations (index 3 ) ===\n",
            "{'LAB_RESULT': [{'sentence': 'ros: pt denies cp, sob, cough, nausea, vomitting, fevers\\n\\npast medical history:\\n- lle cellulitis (recently admitted, treated with unasyn, then\\nswitched to course of augmentin)\\n-iddm, last hga1c 10.1.', 'lab': 'a1c', 'value': '10.1', 'unit': '', 'codes': {'loinc': '4548-4'}}], 'MED_ORDER': []}\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# STEP 6 — Diabetes-Focused Summarization\n",
        "\n",
        "# Keywords that indicate diabetes-related content\n",
        "SUMMARY_KEYWORDS = [\n",
        "    \"dm\", \"dm1\", \"dm2\", \"diabetes\", \"type 1\", \"type 2\",\n",
        "    \"blood sugar\", \"glucose\", \"hyperglycemia\", \"hypoglycemia\",\n",
        "    \"hba1c\", \"a1c\",\n",
        "    \"insulin\", \"metformin\", \"oral agents\",\n",
        "    \"neuropathy\", \"retinopathy\", \"nephropathy\",\n",
        "    \"dka\", \"ketoacidosis\"\n",
        "]\n",
        "\n",
        "def summarize_diabetes_history(sentences):\n",
        "    \"\"\"\n",
        "    Extractive summarization:\n",
        "    - keep sentences containing diabetes keywords\n",
        "    - limit to a few sentences for readability\n",
        "    \"\"\"\n",
        "    if not isinstance(sentences, list):\n",
        "        return \"No usable text available.\"\n",
        "\n",
        "    extracted = []\n",
        "\n",
        "    for sent in sentences:\n",
        "        s_low = sent.lower()\n",
        "        # pick sentences mentioning diabetes, labs, meds, or complications\n",
        "        if any(kw in s_low for kw in SUMMARY_KEYWORDS):\n",
        "            extracted.append(sent.strip())\n",
        "        if len(extracted) >= 5:\n",
        "            break  # keep summary short & clinically relevant\n",
        "\n",
        "    if not extracted:\n",
        "        return \"No explicit diabetes-related information found.\"\n",
        "\n",
        "    # Combine selected sentences into a short readable summary\n",
        "    return \" \".join(extracted)\n",
        "\n",
        "# Apply summarization to every note\n",
        "notes_df[\"dm_summary\"] = notes_df[\"sentences\"].apply(summarize_diabetes_history)\n",
        "\n",
        "# Preview example\n",
        "idx = 3   # the example note you checked earlier\n",
        "print(\"=== Note\", idx, \"Summary ===\\n\")\n",
        "print(notes_df[\"dm_summary\"].iloc[idx])\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
