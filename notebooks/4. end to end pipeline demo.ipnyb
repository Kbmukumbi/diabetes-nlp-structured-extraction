            ],
            "application/vnd.google.colaboratory.intrinsic+json": {
              "type": "dataframe",
              "variable_name": "df_kaggle",
              "summary": "{\n  \"name\": \"df_kaggle\",\n  \"rows\": 36348,\n  \"fields\": [\n    {\n      \"column\": \"instruction\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 1,\n        \"samples\": [\n          \"Detect appropriate relation between the highlighted medical subject and object entity in the content. Subject Entity is highlighted by enclosing in '<<SUBJECT>>' and '<</SUBJECT>>' tokens. Object Entity is highlighted by enclosing in '<<OBJECT>>' and '<</OBJECT>>' tokens.\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"context\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 26532,\n        \"samples\": [\n          \" <<SUBJECT>>INR was corrected<</SUBJECT>> with <<OBJECT>>vitamin K<</OBJECT>> \"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"response\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 19548,\n        \"samples\": [\n          \"{\\\"Subject Entity\\\":\\\"Capsule\\\", \\\"Object Entity\\\":\\\"senna\\\", \\\"Relation\\\":\\\"Form-Drug\\\"}\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
