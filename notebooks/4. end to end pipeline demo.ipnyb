      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "\n",
        "def predict_relation(text: str):\n",
        "    \"\"\"text should have [SUBJ] and [OBJ] markers.\"\"\"\n",
        "    enc = tokenizer(\n",
        "        text,\n",
        "        truncation=True,\n",
        "        padding=\"max_length\",\n",
        "        max_length=128,\n",
        "        return_tensors=\"pt\"\n",
        "    )\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = model(**{k: v for k, v in enc.items()})\n",
        "        logits = outputs.logits\n",
        "        pred_id = torch.argmax(logits, dim=-1).item()\n",
        "\n",
        "    return id2label[pred_id]\n",
        "\n",
        "# Example:\n",
        "example = \"Topiramate [SUBJ]25mg[/SUBJ] [OBJ]Topiramate[/OBJ] PO BID\"\n",
        "print(predict_relation(example))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "jDrR8aEmUNka",
        "outputId": "ce665576-bc57-4e3c-a67f-38c1b731f0bc"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Frequency-Drug\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "\n",
        "# id2label should already exist from earlier:\n",
        "# id2label = {v: k for k, v in label2id.items()}\n",
        "\n",
        "def predict_relation(text: str):\n",
        "    \"\"\"\n",
        "    Predict relation type for one snippet.\n",
        "    `text` must contain [SUBJ]...[/SUBJ] and [OBJ]...[/OBJ].\n",
        "    \"\"\"\n",
        "    enc = tokenizer(\n",
        "        text,\n",
        "        truncation=True,\n",
        "        padding=\"max_length\",\n",
        "        max_length=128,\n",
        "        return_tensors=\"pt\"\n",
        "    )\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = model(**{k: v for k, v in enc.items()})\n",
        "        logits = outputs.logits\n",
        "        pred_id = torch.argmax(logits, dim=-1).item()\n",
        "\n",
        "    return id2label[pred_id]\n"
      ],
      "metadata": {
        "id": "X8z2jYLIUNns"
      },
      "execution_count": null,
      "outputs": []
    },
