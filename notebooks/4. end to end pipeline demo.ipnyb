    },
    {
      "cell_type": "code",
      "source": [
        "#Step 2️ Normalization – map diabetes terms → “code-lik\n",
        "\n",
        "NORMALIZATION_PATTERNS = {\n",
        "    # glucose / blood sugar (LOINC-style)\n",
        "    r\"\\b(fasting blood sugar|fbs)\\b\":        \"GLUCOSE_FASTING_LOINC\",\n",
        "    r\"\\b(random blood sugar|rbs)\\b\":         \"GLUCOSE_RANDOM_LOINC\",\n",
        "    r\"\\b(blood sugar|glucose level)\\b\":      \"GLUCOSE_LOINC\",\n",
        "\n",
        "    # HbA1c (LOINC)\n",
        "    r\"\\b(hb ?a1c|a1c)\\b\":                    \"HBA1C_LOINC\",\n",
        "\n",
        "    # insulin & oral agents (RxNorm-style)\n",
        "    r\"\\b(humalog|novolog|lantus|levemir|tresiba|insulin lispro|insulin glargine)\\b\":\n",
        "                                             \"INSULIN_RXNORM\",\n",
        "    r\"\\bmetf\\w*\\b\":                          \"METFORMIN_RXNORM\",\n",
        "    r\"\\b(glipizide|glyburide|glimepiride)\\b\":\"SULFONYLUREA_RXNORM\",\n",
        "    r\"\\b(januvia|sitagliptin)\\b\":            \"DPP4_INHIBITOR_RXNORM\",\n",
        "    r\"\\b(ozempic|semaglutide|trulicity|dulaglutide)\\b\":\n",
        "                                             \"GLP1_RA_RXNORM\",\n",
        "\n",
        "    # complications (SNOMED-like labels)\n",
        "    r\"\\bdiabetic ketoacidosis\\b\":            \"DKA_SNOMED\",\n",
        "    r\"\\b(diab(\\.|etic)? nephropathy|kidney damage from diabetes)\\b\":\n",
        "                                             \"DIABETIC_NEPHROPATHY_SNOMED\",\n",
        "    r\"\\b(diab(\\.|etic)? neuropathy|nerve damage from diabetes)\\b\":\n",
        "                                             \"DIABETIC_NEUROPATHY_SNOMED\",\n",
        "    r\"\\b(diabetic foot ulcer|foot ulcer)\\b\": \"DIABETIC_FOOT_ULCER_SNOMED\",\n",
        "\n",
        "    # related risk factors\n",
        "    r\"\\bhtn\\b\":                              \"HYPERTENSION_SNOMED\",\n",
        "    r\"\\bhigh blood pressure\\b\":              \"HYPERTENSION_SNOMED\",\n",
        "}\n",
        "\n",
        "def normalize_terms(text: str) -> str:\n",
        "    t = text\n",
        "    # work in lowercase for matching, but keep original case around tokens\n",
        "    t_low = t.lower()\n",
        "    for pattern, repl in NORMALIZATION_PATTERNS.items():\n",
        "        t_low = re.sub(pattern, repl, t_low)\n",
        "    return t_low\n",
        "\n",
        "notes['clean_normalized'] = notes['clean_note'].apply(normalize_terms)\n",
        "print(\"Example after normalization:\\n\", notes['clean_normalized'].iloc[0][:600])\n"
      ],
      "metadata": {
