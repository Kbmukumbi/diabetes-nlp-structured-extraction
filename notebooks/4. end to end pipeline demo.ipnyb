    {
      "cell_type": "code",
      "source": [
        "# STEP 7 — Evaluation & Export of Final NLP Outputs\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# ---------------------------------------------\n",
        "# 1. Coverage statistics for the rule-based NER\n",
        "# ---------------------------------------------\n",
        "total_notes = len(notes_df)\n",
        "\n",
        "notes_with_entities = (notes_df[\"entities\"].apply(len) > 0).sum()\n",
        "notes_with_relations = (\n",
        "    notes_df[\"relations\"].apply(\n",
        "        lambda r: len(r[\"LAB_RESULT\"]) + len(r[\"MED_ORDER\"])\n",
        "    ) > 0\n",
        ").sum()\n",
        "notes_with_summaries = (notes_df[\"dm_summary\"] != \"No explicit diabetes-related information found.\").sum()\n",
        "\n",
        "print(\"===== NLP Pipeline Evaluation (Rule-Based System) =====\\n\")\n",
        "print(f\"Total notes processed:                {total_notes}\")\n",
        "print(f\"Notes with ≥1 diabetes entity:        {notes_with_entities}\")\n",
        "print(f\"Notes with ≥1 lab/med relation:       {notes_with_relations}\")\n",
        "print(f\"Notes with diabetes summary:          {notes_with_summaries}\")\n",
        "\n",
        "entity_coverage = notes_with_entities / total_notes * 100\n",
        "relation_coverage = notes_with_relations / total_notes * 100\n",
        "summary_coverage = notes_with_summaries / total_notes * 100\n",
        "\n",
        "print(\"\\nCoverage Rates:\")\n",
        "print(f\"- Entity extraction coverage:         {entity_coverage:.2f}%\")\n",
        "print(f\"- Relation extraction coverage:       {relation_coverage:.2f}%\")\n",
        "print(f\"- Summary generation coverage:        {summary_coverage:.2f}%\")\n",
        "\n",
        "# ---------------------------------------------\n",
        "# 2. Small preview table for sanity check\n",
        "# ---------------------------------------------\n",
        "preview = notes_df[[\n",
        "    \"subject_id\",\n",
        "    \"hadm_id\",\n",
        "    \"clean_text\",\n",
        "    \"entities_normalized\",\n",
        "    \"relations_normalized\",\n",
        "    \"dm_summary\"\n",
        "]].head(3)\n",
        "\n",
        "print(\"\\n===== Preview of Final Output =====\")\n",
        "display(preview)\n",
        "\n",
        "# ---------------------------------------------\n",
        "# 3. Save enriched dataset for reporting\n",
        "# ---------------------------------------------\n",
        "OUTPUT_PATH = \"/content/drive/MyDrive/diabetes_nlp_pipeline_output.csv\"\n",
        "\n",
        "notes_df[[\n",
