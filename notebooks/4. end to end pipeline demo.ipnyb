      "cell_type": "code",
      "source": [
        "# Below we start preprocessing  our 20k diabetes notes exactly using:\n",
        "#Cleaning\n",
        "#Normalization (UMLS/SNOMED/LOINC/RxNorm–style codes)\n",
        "#Segmentation (sections + sentences)\n",
        "#============================\n",
        "# Step 0. Imports & load 20k notes\n",
        "# ============================\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "import pandas as pd\n",
        "import re\n",
        "\n",
        "IN_PATH  = '/content/drive/MyDrive/diabetes_discharge_20k.csv'\n",
        "OUT_PATH = '/content/drive/MyDrive/diabetes_discharge_20k_preprocessed.csv'\n",
        "\n",
        "notes = pd.read_csv(IN_PATH)\n",
        "\n",
        "# Try to detect the text column\n",
        "TEXT_COL = 'text'\n",
        "if TEXT_COL not in notes.columns:\n",
        "    if 'clean_text' in notes.columns:\n",
        "        TEXT_COL = 'clean_text'\n",
        "    else:\n",
        "        # fallback: last column\n",
        "        TEXT_COL = notes.columns[-1]\n",
        "\n",
        "print(\"Using text column:\", TEXT_COL)\n",
        "print(\"Notes shape:\", notes.shape)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ZQnBusCrr0lS",
        "outputId": "a89ff124-3707-416c-ba37-0b3c6cd4c15e"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n",
            "Using text column: text\n",
            "Notes shape: (20000, 4)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 1- Cleaning – removing PHI, weird chars, fix whitespace (no lowercasing)\n",
        "\n",
        "# pattern for MIMIC-style de-identification markers: [**...**]\n",
        "PHI_BRACKETS = re.compile(r\"\\[\\*\\*.*?\\*\\*\\]\")\n",
        "\n",
        "def clean_text_basic(text: str) -> str:\n",
        "    t = str(text)\n",
        "\n",
        "    # remove [** PHI **] spans\n",
        "    t = PHI_BRACKETS.sub(\" \", t)\n",
        "\n",
        "    # remove runs of underscores / leftover fake identifiers\n",
        "    t = re.sub(r\"_+\", \" \", t)\n",
        "\n",
        "    # keep only reasonable characters (letters, numbers, basic punct, newline)\n",
        "    t = re.sub(r\"[^\\x09\\x0A\\x0D\\x20-\\x7E]\", \" \", t)\n",
        "\n",
        "    # normalize spaces\n",
        "    t = re.sub(r\"[ \\t]+\", \" \", t)\n",
        "    t = re.sub(r\"\\s+\\n\", \"\\n\", t)\n",
        "    t = re.sub(r\"\\n\\s+\", \"\\n\", t)\n",
        "\n",
        "    # strip leading/trailing whitespace\n",
        "    t = t.strip()\n",
        "    return t\n",
        "\n",
        "notes['clean_note'] = notes[TEXT_COL].apply(clean_text_basic)\n",
        "print(\"Example cleaned note:\\n\", notes['clean_note'].iloc[0][:600])\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
