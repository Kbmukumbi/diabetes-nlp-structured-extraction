    {
      "cell_type": "code",
      "source": [
        "#6.3 Simple section segmentation\n",
        "# ---------- Section segmentation (simple heading-based) ----------\n",
        "\n",
        "SECTION_HEADERS = [\n",
        "    \"history of present illness\",\n",
        "    \"past medical history\",\n",
        "    \"social history\",\n",
        "    \"family history\",\n",
        "    \"physical exam\",\n",
        "    \"medications on admission\",\n",
        "    \"discharge medications\",\n",
        "    \"discharge diagnosis\",\n",
        "    \"discharge condition\",\n",
        "    \"discharge instructions\",\n",
        "    \"followup instructions\",\n",
        "    \"brief hospital course\"\n",
        "]\n",
        "\n",
        "def segment_sections(text: str):\n",
        "    \"\"\"\n",
        "    Returns a dict: {section_name: section_text}\n",
        "    based on simple 'header:' markers in the note.\n",
        "    \"\"\"\n",
        "    if not text:\n",
        "        return {}\n",
        "\n",
        "    lower = text.lower()\n",
        "    positions = []\n",
        "\n",
        "    # find all header positions\n",
        "    for header in SECTION_HEADERS:\n",
        "        pattern = header + \":\"\n",
        "        idx = lower.find(pattern)\n",
        "        if idx != -1:\n",
        "            positions.append((idx, header))\n",
        "\n",
        "    if not positions:\n",
        "        return {}\n",
        "\n",
        "    positions = sorted(positions)\n",
        "    sections = {}\n",
        "\n",
        "    for i, (start, header) in enumerate(positions):\n",
        "        end = positions[i+1][0] if i + 1 < len(positions) else len(text)\n",
        "        sections[header] = text[start:end].strip()\n",
        "\n",
        "    return sections\n",
        "\n",
        "subset_for_seg['sections'] = subset_for_seg['clean_text'].apply(segment_sections)\n",
        "\n",
        "print(\"\\nExample SECTIONS:\\n\")\n",
        "for k, v in subset_for_seg['sections'].iloc[0].items():\n",
        "    print(f\"--- {k.upper()} ---\")\n",
        "    print(v[:400], \"\\n\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4mNf9DG48RSL",
