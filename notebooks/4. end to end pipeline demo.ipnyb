    },
    {
      "cell_type": "code",
      "source": [
        "# STEP 4 — Improved rule-based relation extraction (with clean numeric values)\n",
        "\n",
        "def extract_relations_from_note(sentences):\n",
        "    \"\"\"\n",
        "    Returns:\n",
        "      {\n",
        "        \"LAB_RESULT\": [ {lab, value, unit, sentence}, ... ],\n",
        "        \"MED_ORDER\":  [ {med, dose, sentence}, ... ]\n",
        "      }\n",
        "    \"\"\"\n",
        "    rels = {\"LAB_RESULT\": [], \"MED_ORDER\": []}\n",
        "    if not isinstance(sentences, (list, tuple)):\n",
        "        return rels\n",
        "\n",
        "    for sent in sentences:\n",
        "        if not isinstance(sent, str):\n",
        "            continue\n",
        "        s_low = sent.lower()\n",
        "\n",
        "        # ---- LAB_RESULT patterns ----\n",
        "        lab_pattern = re.compile(\n",
        "            r\"(hba1c|a1c|glucose|blood sugar)\\s*\"\n",
        "            r\"(was|is|of|=|:)?\\s*\"\n",
        "            r\"([\\d\\.]+)\\s*\"\n",
        "            r\"([%/a-zA-Z]*)\"\n",
        "        )\n",
        "        lab_match = lab_pattern.search(s_low)\n",
        "        if lab_match:\n",
        "            raw_value = lab_match.group(3)\n",
        "            # strip trailing punctuation like '.', ',', ';'\n",
        "            clean_value = raw_value.rstrip(\".,;\")\n",
        "\n",
        "            rels[\"LAB_RESULT\"].append({\n",
        "                \"sentence\": sent.strip(),\n",
        "                \"lab\": lab_match.group(1),\n",
        "                \"value\": clean_value,\n",
        "                \"unit\": lab_match.group(4)\n",
        "            })\n",
        "\n",
        "        # ---- MED_ORDER patterns ----\n",
        "        med_pattern = re.compile(\n",
        "            r\"(insulin|metformin|glyburide|glipizide|glimepiride)\\s+\"\n",
        "            r\"([\\d\\.]+\\s*(units|u|mg)[^.,;]*)\"\n",
        "        )\n",
        "        med_match = med_pattern.search(s_low)\n",
        "        if med_match:\n",
        "            rels[\"MED_ORDER\"].append({\n",
        "                \"sentence\": sent.strip(),\n",
        "                \"med\": med_match.group(1),\n",
        "                \"dose\": med_match.group(2)\n",
        "            })\n",
        "\n",
        "    return rels\n",
        "\n",
        "notes_df[\"relations\"] = notes_df[\"sentences\"].apply(extract_relations_from_note)\n"
      ],
      "metadata": {
        "id": "yO8vnb01C8OS"
      },
      "execution_count": null,
      "outputs": []
    },
