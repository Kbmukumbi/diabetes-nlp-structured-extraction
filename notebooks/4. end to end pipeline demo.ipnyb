      "source": [
        "# STEP 2 — Tokenization & sentence structure\n",
        "\n",
        "def simple_tokenize(text: str):\n",
        "    \"\"\"Very light tokenization: split on whitespace.\"\"\"\n",
        "    if not isinstance(text, str):\n",
        "        return []\n",
        "    return text.split()\n",
        "\n",
        "# Add tokens column at note level\n",
        "notes_df[\"tokens\"] = notes_df[\"clean_text\"].fillna(\"\").apply(simple_tokenize)\n",
        "\n",
        "print(\"Example tokenization preview:\\n\")\n",
        "print(\"TOKENS:\", notes_df[\"tokens\"].iloc[0][:40])\n",
        "print(\"\\nSENTENCES:\", notes_df[\"sentences\"].iloc[0][:3])\n"
      ],
