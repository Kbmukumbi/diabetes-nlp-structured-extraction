    {
      "cell_type": "code",
      "source": [
        "# ---------- STEP 5: NORMALIZATION (diabetes-related terminology) ----------\n",
        "\n",
        "# patterns: canonical_term -> list of regex patterns to replace\n",
        "normalization_patterns = {\n",
        "    \"diabetes mellitus\": [\n",
        "        r\"\\bdm\\b\",\n",
        "        r\"\\bdiabetes\\b\"\n",
        "    ],\n",
        "    \"type 1 diabetes\": [\n",
        "        r\"\\bt1dm\\b\",\n",
        "        r\"\\btype 1 dm\\b\",\n",
        "        r\"\\btype i diabetes\\b\"\n",
        "    ],\n",
        "    \"type 2 diabetes\": [\n",
        "        r\"\\bt2dm\\b\",\n",
        "        r\"\\btype 2 dm\\b\",\n",
        "        r\"\\btype ii diabetes\\b\",\n",
        "        r\"\\bniddm\\b\"\n",
        "    ],\n",
        "    \"insulin\": [\n",
        "        r\"\\bins\\b\",\n",
        "        r\"\\binsulin\\b\"\n",
        "    ],\n",
        "    \"glucose\": [\n",
        "        r\"\\bblood sugar\\b\",\n",
        "        r\"\\bsugar level(s)?\\b\",\n",
        "        r\"\\bglc\\b\",\n",
        "        r\"\\bglu\\b\"\n",
        "    ],\n",
        "    \"hba1c\": [\n",
        "        r\"\\ba1c\\b\",\n",
        "        r\"\\bhba1c\\b\",\n",
        "        r\"\\bglycated hemoglobin\\b\"\n",
        "    ],\n",
        "    \"metformin\": [\n",
        "        r\"\\bglucophage\\b\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "def normalize_terms(text: str) -> str:\n",
        "    if not text:\n",
        "        return text\n",
        "    out = text\n",
        "    for canonical, patterns in normalization_patterns.items():\n",
        "        for pat in patterns:\n",
        "            out = re.sub(pat, canonical, out, flags=re.IGNORECASE)\n",
        "    return out\n",
        "\n",
        "# Apply normalization on top of clean_text\n",
        "diabetes_notes_20k['clean_text'] = diabetes_notes_20k['clean_text'].apply(normalize_terms)\n",
        "\n",
        "print(\"\\nExample after NORMALIZATION:\\n\")\n",
        "print(diabetes_notes_20k['clean_text'].iloc[0][:1000])\n"
      ],
